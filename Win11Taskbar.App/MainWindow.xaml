<Window x:Class="Win11Taskbar.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Win11Taskbar" Width="1090" Height="810" MinWidth="840" MinHeight="600"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource StudioFont}" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="51" ResizeBorderThickness="6" CornerRadius="13" GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <DrawingBrush x:Key="Wallpaper" Stretch="Fill">
            <DrawingBrush.Drawing>
                <DrawingGroup ClipGeometry="M0,0 H800 V233 H0Z">
                    <GeometryDrawing Geometry="M0,0H800V233H0Z">
                        <GeometryDrawing.Brush>
                            <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                <GradientStop Offset="0" Color="#1F204A"/>
                                <GradientStop Offset=".50" Color="#35317B"/>
                                <GradientStop Offset="1" Color="#256B8D"/>
                            </LinearGradientBrush>
                        </GeometryDrawing.Brush>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="M245,233 C390,194 553,111 589,-12 L674,-12 C629,137 512,215 392,248 Z">
                        <GeometryDrawing.Brush>
                            <LinearGradientBrush StartPoint=".2,1" EndPoint=".9,0">
                                <GradientStop Offset="0" Color="#3B3889"/>
                                <GradientStop Offset=".43" Color="#7A65D2"/>
                                <GradientStop Offset=".71" Color="#9DA1F3"/>
                                <GradientStop Offset="1" Color="#57B7D0"/>
                            </LinearGradientBrush>
                        </GeometryDrawing.Brush>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="M420,243 C524,201 641,115 677,-10 H752 C702,139 579,221 502,245 Z">
                        <GeometryDrawing.Brush>
                            <LinearGradientBrush StartPoint="0,1" EndPoint=".85,0">
                                <GradientStop Offset="0" Color="#8872ED"/>
                                <GradientStop Offset=".49" Color="#6B8EDF"/>
                                <GradientStop Offset=".91" Color="#37B7C3"/>
                                <GradientStop Offset="1" Color="#78CFCB"/>
                            </LinearGradientBrush>
                        </GeometryDrawing.Brush>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="M560,249 C669,193 746,116 764,-24 H829 V73 C796,176 708,224 650,248 Z">
                        <GeometryDrawing.Brush>
                            <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                <GradientStop Offset="0" Color="#5091D3"/>
                                <GradientStop Offset=".63" Color="#2F7EB5"/>
                                <GradientStop Offset="1" Color="#36A5AC"/>
                            </LinearGradientBrush>
                        </GeometryDrawing.Brush>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="M0,0 H800 V233 H0Z">
                        <GeometryDrawing.Brush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,.24">
                                <GradientStop Offset="0" Color="#C2141233"/>
                                <GradientStop Offset=".45" Color="#221D1743"/>
                                <GradientStop Offset="1" Color="#002A2450"/>
                            </LinearGradientBrush>
                        </GeometryDrawing.Brush>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>
    <Border x:Name="WindowFrame" BorderBrush="{DynamicResource Line}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="51"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                <Grid Margin="18,0,9,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource Accent}" CornerRadius="8" Width="28" Height="28">
                            <Path Data="{StaticResource BrandMark}" Fill="{DynamicResource AccentText}" Width="19" Height="13" Stretch="Uniform"/>
                        </Border>
                        <TextBlock Text="Win11Taskbar" Margin="9,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource CaptionButton}" Click="MinimizeClick" ToolTip="Свернуть" AutomationProperties.Name="Свернуть">
                            <Path Data="M0,0 H10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"/>
                        </Button>
                        <Button Style="{StaticResource CaptionButton}" Click="MaximizeClick" ToolTip="Развернуть или восстановить"
                                AutomationProperties.Name="Развернуть или восстановить">
                            <Path x:Name="MaximizeGlyph" Data="M0,0 H9 V9 H0Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.15"/>
                        </Button>
                        <Button Style="{StaticResource CaptionButton}" Click="CloseClick" ToolTip="Закрыть в трей" AutomationProperties.Name="Закрыть в трей">
                            <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="224"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.RowSpan="2" Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource Line}"
                        BorderThickness="0,0,1,0" Padding="12,21,12,17">
                    <DockPanel>
                        <Border DockPanel.Dock="Bottom" CornerRadius="10" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                Background="{DynamicResource CardBg}" Padding="10,10" Margin="2,15,2,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{DynamicResource Muted}" VerticalAlignment="Top" Margin="1,5,8,0"/>
                                <TextBlock x:Name="StatusText" Grid.Column="1" Text="Подключение к панели задач…" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Muted}" FontSize="11"/>
                            </Grid>
                        </Border>
                        <StackPanel x:Name="Navigation" KeyboardNavigation.TabNavigation="Once"/>
                    </DockPanel>
                </Border>
                <ScrollViewer x:Name="PageScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False" PanningMode="VerticalOnly">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource StudioScrollBar}"/>
                    </ScrollViewer.Resources>
                    <StackPanel MaxWidth="1080" Margin="30,25,30,30">
                        <TextBlock x:Name="PageTitle" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="34"/>
                        <TextBlock x:Name="PageSubtitle" Foreground="{DynamicResource Muted}" Margin="0,4,0,20" FontSize="13" TextWrapping="Wrap"/>

                        <Border x:Name="PreviewFrame" Padding="0" Margin="0,0,0,18" CornerRadius="15" BorderBrush="#685F96"
                                BorderThickness="1" Background="{StaticResource Wallpaper}" Height="202">
                            <Grid>
                                <StackPanel Margin="20,17" VerticalAlignment="Top">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="#A9F1E7" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="ЖИВОЕ ПРЕВЬЮ" Foreground="#E7E3FE" FontSize="10" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <TextBlock x:Name="PreviewStyleLabel" Foreground="White" FontFamily="{StaticResource DisplayFont}" FontSize="22"
                                               FontWeight="SemiBold" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Border x:Name="PreviewViewport" VerticalAlignment="Bottom" Margin="12,0,12,11"
                                        CornerRadius="6" Padding="0" Background="Transparent">
                                    <Border x:Name="PreviewBar" Height="48" VerticalAlignment="Bottom" CornerRadius="10" BorderThickness="1">
                                        <Grid ClipToBounds="True">
                                            <Border x:Name="PreviewGlass" CornerRadius="{Binding CornerRadius, ElementName=PreviewBar}"
                                                    Background="{StaticResource Wallpaper}" IsHitTestVisible="False"/>
                                            <Border x:Name="PreviewTint" CornerRadius="{Binding CornerRadius, ElementName=PreviewBar}"
                                                    IsHitTestVisible="False"/>
                                            <StackPanel x:Name="PreviewIcons" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <StackPanel x:Name="PreviewTray" Orientation="Horizontal" HorizontalAlignment="Right"
                                                        VerticalAlignment="Center" Margin="0,0,11,0"/>
                                        </Grid>
                                    </Border>
                                </Border>
                            </Grid>
                        </Border>
                        <Border x:Name="NoticeBox" Background="{DynamicResource AccentSubtle}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                CornerRadius="9" Padding="12" Margin="0,0,0,12" Visibility="Collapsed">
                            <TextBlock x:Name="NoticeText" TextWrapping="Wrap" Foreground="{DynamicResource Text}"/>
                        </Border>
                        <StackPanel x:Name="PageContent"/>
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Column="1" Grid.Row="1" Background="{DynamicResource SidebarBg}"
                        BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                    <Grid Margin="30,11,30,11" MaxWidth="1080">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid VerticalAlignment="Center" Margin="0,0,14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="DraftDot" Width="7" Height="7" Margin="0,5,8,0" VerticalAlignment="Top"
                                     Fill="{DynamicResource Muted}"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="DraftStatus" Text="Изменений нет" FontSize="12" FontWeight="SemiBold"
                                           TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                                <TextBlock Text="Панель Windows обновится после сохранения" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="DiscardDraftButton" Content="Отменить" Click="RevertDraftClick"
                                    IsEnabled="False" MinWidth="91" Margin="0,0,8,0"/>
                            <Button x:Name="SaveDraftButton" Content="Сохранить" Click="SaveDraftClick"
                                    IsEnabled="False" MinWidth="101" Background="{DynamicResource Accent}"
                                    BorderBrush="{DynamicResource Accent}" Foreground="{DynamicResource AccentText}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
