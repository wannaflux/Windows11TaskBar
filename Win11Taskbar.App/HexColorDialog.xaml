<Window x:Class="Win11Taskbar.App.HexColorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Выбор цвета" Width="474" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="{DynamicResource WindowBg}"
        FontFamily="{StaticResource StudioFont}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="60" ResizeBorderThickness="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" CornerRadius="12"/>
    </shell:WindowChrome.WindowChrome>
    <Border BorderThickness="1" BorderBrush="{DynamicResource Line}" CornerRadius="12" Padding="22,14,22,18">
        <StackPanel KeyboardNavigation.TabNavigation="Cycle">
            <Grid Margin="0,1,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="DialogHeading" VerticalAlignment="Center" FontFamily="{StaticResource DisplayFont}"
                           FontSize="24" FontWeight="SemiBold"/>
                <Button Grid.Column="1" Style="{StaticResource CaptionButton}" Width="32"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="Закрыть" Click="CancelClick" ToolTip="Закрыть">
                    <Path Data="M1,1 L9,9 M9,1 L1,9" Stroke="{DynamicResource Muted}" StrokeThickness="1.35"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>
            </Grid>

            <Border x:Name="TonePlane" Height="174" CornerRadius="10" Background="Transparent"
                    Padding="1" BorderThickness="1" BorderBrush="{DynamicResource Line}"
                    Focusable="True" KeyboardNavigation.TabIndex="1" FocusVisualStyle="{StaticResource FocusRing}"
                    Cursor="Cross"
                    AutomationProperties.Name="Насыщенность и яркость"
                    AutomationProperties.HelpText="Стрелки меняют насыщенность и яркость, Shift ускоряет изменение."
                    MouseLeftButtonDown="PlaneMouseDown" MouseMove="PlaneMouseMove" MouseLeftButtonUp="PlaneMouseUp"
                    KeyDown="PlaneKeyDown">
                <Grid>
                    <Border x:Name="HueFill" CornerRadius="9" Background="#FF0000"/>
                    <Border CornerRadius="9">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border CornerRadius="9">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop Color="#FF000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Canvas x:Name="ToneCanvas" IsHitTestVisible="False" SizeChanged="PlaneSizeChanged">
                        <Grid x:Name="ToneMarker" Width="20" Height="20">
                            <Ellipse Stroke="#C0111420" StrokeThickness="3"/>
                            <Ellipse Stroke="White" StrokeThickness="2" Margin="2"/>
                            <Ellipse x:Name="ToneMarkerFill" Margin="5"/>
                        </Grid>
                    </Canvas>
                </Grid>
            </Border>

            <Slider x:Name="HueSlider" Margin="0,8,0,10" Width="Auto" Height="26" Minimum="0" Maximum="360"
                    SmallChange="1" LargeChange="15" IsSnapToTickEnabled="False" KeyboardNavigation.TabIndex="2"
                    ValueChanged="HueChanged" AutomationProperties.Name="Цветовой тон">
                <Slider.Template>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Border Height="11" CornerRadius="6" VerticalAlignment="Center" Margin="8,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FF0000" Offset="0"/>
                                        <GradientStop Color="#FFFF00" Offset=".166667"/>
                                        <GradientStop Color="#00FF00" Offset=".333333"/>
                                        <GradientStop Color="#00FFFF" Offset=".5"/>
                                        <GradientStop Color="#0000FF" Offset=".666667"/>
                                        <GradientStop Color="#FF00FF" Offset=".833333"/>
                                        <GradientStop Color="#FF0000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Track x:Name="PART_Track" Orientation="Horizontal">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="20" Height="20">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Background="Transparent">
                                                    <Ellipse Fill="#26161C29" Stroke="#BD151725" StrokeThickness="3"/>
                                                    <Ellipse Stroke="White" StrokeThickness="2" Margin="2"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Slider.Template>
            </Slider>

            <TextBlock Text="Готовые цвета" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"
                       Margin="0,0,0,7"/>
            <UniformGrid x:Name="SwatchGrid" Rows="1" Margin="-3,0,-3,14" KeyboardNavigation.TabNavigation="Once"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,18,0">
                    <TextBlock Text="HEX" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="HexInput" Height="36" FontFamily="Consolas" FontSize="15" CharacterCasing="Upper"
                             MaxLength="24" KeyboardNavigation.TabIndex="4" TextChanged="HexChanged"
                             AutomationProperties.Name="Код цвета HEX"/>
                    <TextBlock x:Name="HexHint" Text="Формат #RRGGBB" FontSize="11" Foreground="{DynamicResource Muted}"
                               Margin="0,5,0,0" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="36"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Текущий" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Grid.Column="1" Text="Новый" FontSize="12" FontWeight="SemiBold" Margin="7,0,0,6"/>
                    <Border x:Name="CurrentSample" Grid.Row="1" CornerRadius="6,0,0,6"
                            BorderThickness="1,1,0,1" BorderBrush="{DynamicResource Line}"/>
                    <Border x:Name="NewSample" Grid.Row="1" Grid.Column="1" CornerRadius="0,6,6,0"
                            BorderThickness="1" BorderBrush="{DynamicResource Line}"/>
                </Grid>
            </Grid>
            <Border Margin="0,14,0,11" Height="1" Background="{DynamicResource Line}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" MinWidth="88" Margin="0,0,8,0" IsCancel="True" KeyboardNavigation.TabIndex="5"/>
                <Button x:Name="ApplyButton" Content="Выбрать" MinWidth="113" IsDefault="True" Click="ApplyClick"
                        BorderBrush="Transparent" Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentText}"
                        FontWeight="SemiBold" KeyboardNavigation.TabIndex="6"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
